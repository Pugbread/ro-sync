{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ro Sync",
  "version": "0.1.0",
  "identifier": "com.pugbread.rosync.desktop",
  "build": {
    "beforeDevCommand": "npm run sync",
    "beforeBuildCommand": "npm run sync",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ro Sync",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        },
        "hiddenTitle": true,
        "transparent": false,
        "backgroundThrottling": "disabled",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Roblox Studio bridge for agents and developers",
    "longDescription": "Ro Sync connects a local project and command-line clients to Roblox Studio.",
    "externalBin": [
      "binaries/rosync"
    ],
    "resources": {
      "resources/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Pugbread/ro-sync/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
